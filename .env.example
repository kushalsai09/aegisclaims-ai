# Copy to .env for local Docker Compose use. These values are synthetic/local only.
APP_ENV=local
VITE_AUTH_MODE=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:5173
API_DOCS_ENABLED=true

DATABASE_URL=postgresql+psycopg://insurance:insurance_local_only@postgres:5432/insurance_ops
AUTH_PROVIDER=local
DEV_AUTH_SECRET=replace-with-a-long-local-only-secret-at-least-32-characters
SESSION_COOKIE_NAME=harborview_session
SESSION_TTL_SECONDS=28800
SESSION_REMEMBER_TTL_SECONDS=2592000
# Production OIDC additionally requires OIDC_ISSUER, OIDC_AUDIENCE,
# OIDC_CLIENT_ID, OIDC_CLIENT_SECRET, OIDC_REDIRECT_URI, and OIDC_TENANT_ID.

OBJECT_STORAGE_PROVIDER=s3_compatible
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=insurance-documents
OBJECT_STORAGE_ACCESS_KEY=minio_local_only
OBJECT_STORAGE_SECRET_KEY=minio_local_only_secret

QUEUE_PROVIDER=redis
RATE_LIMIT_PROVIDER=redis
AUTH_RATE_LIMIT=10
RETRIEVAL_RATE_LIMIT=60
MODEL_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60
MODEL_PROVIDER=deterministic
MODEL_TIMEOUT_SECONDS=8
MODEL_MAX_RETRIES=1
MODEL_MAX_INPUT_CHARACTERS=30000
MODEL_MAX_OUTPUT_TOKENS=1200
# To opt into the real adapter, set MODEL_PROVIDER=bedrock plus both values below.
# BEDROCK_MODEL_ID=approved-foundation-model-or-inference-profile
# BEDROCK_REGION=us-east-1
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=insurance-operations

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=insurance-api

VITE_API_BASE_URL=http://localhost:8000
