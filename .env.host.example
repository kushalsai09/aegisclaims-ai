# Copy to .env when running without Docker. These values are local-only.
APP_ENV=local
VITE_AUTH_MODE=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:5173
API_DOCS_ENABLED=true

DATABASE_URL=sqlite+pysqlite:///./.local/insurance_ops.db
AUTH_PROVIDER=local
DEV_AUTH_SECRET=replace-with-a-long-local-only-secret-at-least-32-characters
SESSION_COOKIE_NAME=harborview_session
SESSION_TTL_SECONDS=28800
SESSION_REMEMBER_TTL_SECONDS=2592000

OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_PATH=.local/object-storage
QUEUE_PROVIDER=memory
RATE_LIMIT_PROVIDER=memory
AUTH_RATE_LIMIT=10
RETRIEVAL_RATE_LIMIT=60
MODEL_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60
MODEL_PROVIDER=deterministic
MODEL_TIMEOUT_SECONDS=8
MODEL_MAX_RETRIES=1
MODEL_MAX_INPUT_CHARACTERS=30000
MODEL_MAX_OUTPUT_TOKENS=1200
# BEDROCK_MODEL_ID and BEDROCK_REGION are required only when MODEL_PROVIDER=bedrock.
OTEL_ENABLED=false
